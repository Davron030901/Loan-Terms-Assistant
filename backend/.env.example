# ─── Provider routing ─────────────────────────────────────────────────────────
# Chat runs on CHAT_PROVIDER and automatically fails over to CHAT_FALLBACK_PROVIDER.
# Safe to fail over: whatever either model writes still has to pass the citation
# validator and the grounding guard before anyone sees it.
CHAT_PROVIDER=openai
CHAT_FALLBACK_PROVIDER=gemini        # set to "none" to disable failover

# Embeddings use ONE provider and never fail over. Two embedding models are two
# different vector spaces; mixing them makes retrieval silently meaningless.
# Changing this REQUIRES: python -m scripts.ingest_all --all --recreate
EMBED_PROVIDER=gemini

# ─── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=                      # primary chat provider
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_BASE_URL=                     # optional: a proxy or Azure-compatible endpoint

# ─── Google Gemini ────────────────────────────────────────────────────────────
GOOGLE_API_KEY=                      # fallback chat provider + embeddings
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=models/gemini-embedding-001
EMBED_DIM=768                        # must match the Qdrant collection exactly
LLM_TEMPERATURE=0                    # determinism is a safety feature here

# Optional: route through a LiteLLM / class proxy instead of Google directly.
# Leave EMPTY to call Google directly (default).
GEMINI_BASE_URL=

# ─── Qdrant Cloud ─────────────────────────────────────────────────────────────
QDRANT_URL=                          # https://<cluster-id>.<region>.aws.cloud.qdrant.io
QDRANT_API_KEY=                      # REQUIRED
QDRANT_COLLECTION=loan_terms

# ─── Retrieval tuning ─────────────────────────────────────────────────────────
RETRIEVER_TOP_K=6
RETRIEVER_SCORE_FLOOR=0.55           # below this -> treat as "no evidence"
CHUNK_SIZE=1000
CHUNK_OVERLAP=180

# ─── Agent behaviour ──────────────────────────────────────────────────────────
DEFAULT_DOC_ID=cibc_personal
ENABLE_STREAMING=true
MAX_QUESTION_CHARS=600
REQUEST_TIMEOUT_SECONDS=45

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=8000
LOG_LEVEL=INFO
ENVIRONMENT=development
WEB_CONCURRENCY=1
RATE_LIMIT_PER_MINUTE=20

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000
CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# ─── Ingestion ────────────────────────────────────────────────────────────────
AUTO_INGEST=false
